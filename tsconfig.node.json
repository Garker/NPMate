{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "electron/**/*.ts",
    "database/**/*.ts",
    "src/types/**/*.ts",
    "electron.vite.config.ts"
  ]
}
