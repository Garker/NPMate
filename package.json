{
  "name": "npmate",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Garker/NPMate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Garker/NPMate.git"
  },
  "bugs": {
    "url": "https://github.com/Garker/NPMate/issues"
  },
  "description": "AI JavaScript package manager desktop application",
  "author": {
    "name": "NPMate contributors",
    "email": "56073411+Garker@users.noreply.github.com"
  },
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.44",
    "@ai-sdk/react": "^4.0.47",
    "@ant-design/icons": "latest",
    "@fontsource-variable/ibm-plex-sans": "latest",
    "@fontsource-variable/space-grotesk": "latest",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/google": "^0.2.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.44",
    "antd": "latest",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "langchain": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "^2.5.0",
    "zod": "^4.4.3",
    "zustand": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9",
    "typescript-eslint": "latest",
    "vite": "^7"
  },
  "build": {
    "appId": "dev.npmate.desktop",
    "productName": "NPMate",
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Garker",
      "repo": "NPMate",
      "releaseType": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
